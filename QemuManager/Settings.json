{
    "$schema": "https://raw.githubusercontent.com/TheEndHunter/QemuManager/main/Schemas/Settings.schema.json",
    "OVMFConfig": {
        "Author": "TheEndHunter",
        "Repo": "OVMF_BIN",
        "OVMFBinPath": "Latest",
        "Branch": "main"
    },
    "EnableLogging": true,
    "EnableRawLogging": true,
    "RawStdioMode": true,

    "Configurations": [
        {
            "Name": "Debug"
        },
        {
            "Name": "Release"
        }
